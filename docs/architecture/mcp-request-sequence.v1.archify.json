  "cards": [
    {
      "dot": "cyan",
      "title": "Session contract",
      "items": [
        "Initialize is the only POST allowed without a session ID",
        "Later requests resolve the in-memory transport by session ID",
        "Unknown sessions return HTTP 404"
      ]
    },
    {
      "dot": "emerald",
      "title": "Read path",
      "items": [
        "Six tools delegate to one DevToAPI instance per McpServer",
        "DevToAPI performs the public HTTPS request",
        "Responses are serialized into an MCP text content block"
      ]
    },
    {
      "dot": "amber",
      "title": "Current limits",
      "items": [
        "Session expiry and cleanup are not implemented",
        "Forem responses remain untyped unknown values",
        "Tool-call behavior is not yet covered by characterization tests"
      ]
    }
  ]
